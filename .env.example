# ======================================================================
# SchoolPlatform - متغيرات البيئة
# انسخ هذا الملف إلى ".env" وضع القيم الصحيحة قبل النشر.
# ======================================================================

# ---------- Django (مطلوبة في الإنتاج) ----------
# مفتاح التوقيع السري — أنشئ واحداً قوياً، مثال:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# المضيفات المسموح بها (مفصولة بفواصل) — مثال: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# عنوان لوحة الإدارة (يُستخدم في deploy.sh)
DJANGO_ADMIN_URL=admin/

# ---------- قاعدة البيانات (PostgreSQL في الإنتاج) ----------
DJANGO_DB_NAME=schoolplatform
DJANGO_DB_USER=schoolplatform
DJANGO_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# ---------- أمان (اختياري، لها قيم افتراضية آمنة) ----------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ---------- البريد (اختياري) ----------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=CHANGE_ME
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SchoolPlatform <no-reply@example.com>

# ---------- Google Gemini (الذكاء الاصطناعي المساعد) ----------
# مفتاح Gemini المجاني من Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_FREE_GEMINI_API_KEY

# النموذج المستخدم (مجاني). اتركه افتراضياً.
GEMINI_MODEL=gemini-2.5-flash

# نماذج احتياطية مفصولة بفواصل تُستخدم عند فشل النموذج الأساسي.
GEMINI_BACKUP_MODELS=gemini-2.0-flash

# تفعيل البحث عبر Google (مصادر حقيقية) — مجاني مع المفتاح.
GEMINI_ENABLE_SEARCH=1

# مهلة الطلب بالثواني.
GEMINI_TIMEOUT=30

# أقصى عدد رموز (tokens) لكل رد.
GEMINI_MAX_OUTPUT_TOKENS=4096
