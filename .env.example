# ======================================================================
# SchoolPlatform - متغيرات البيئة
# انسخ هذا الملف إلى ".env" محلياً، أو ضع القيم في لوحة Render.
# لا تُرفع القيم الحقيقية إلى Git أبداً.
# ======================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

# ---------- Django (مطلوبة في الإنتاج) ----------
# مفتاح التوقيع السري — أنشئ واحداً قوياً، مثال:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# المضيفات المسموح بها (مفصولة بفواصل)
# على Render أضف: schoolplatform.onrender.com
DJANGO_ALLOWED_HOSTS=schoolplatform.onrender.com

# أصول CSRF الموثوقة (مفصولة بفواصل) — تشمل https
DJANGO_CSRF_TRUSTED_ORIGINS=https://schoolplatform.onrender.com

# عنوان لوحة الإدارة
DJANGO_ADMIN_URL=admin/

# ---------- قاعدة البيانات: Neon Postgres ----------
# استخدم رابط الاتصال المجمّع (يحتوي على "-pooler") من لوحة Neon.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# ---------- تخزين الوسائط: Neon Object Storage (متوافق مع S3) ----------
# أنشئ Bucket خاصاً ثم Credential بصلاحيتي storage:read وstorage:write.
# عند ترك هذه القيم فارغة سيُستخدم القرص المحلي (غير دائم على Render).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ---------- الأمان ----------
# إعادة التوجيه إلى HTTPS (Render يوفّر TLS)
DJANGO_SECURE_SSL_REDIRECT=1
# لا تفعّل HSTS إلا بعد تثبيت النطاق النهائي
DJANGO_SECURE_HSTS_SECONDS=0

# ---------- المساعد الذكي (اختياري) ----------
# مفتاح OpenRouter المجاني من https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BACKUP_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_TIMEOUT=30

# حدود رفع الملفات للمساعد
ASSISTANT_MAX_FILES=10
ASSISTANT_MAX_FILE_SIZE_MB=20

# ملاحظة: المتغيرات القديمة DJANGO_DB_* وGEMINI_* لم تعد مستخدمة.
# قاعدة البيانات تُقرأ من DATABASE_URL، والمساعد من OPENROUTER_*.
