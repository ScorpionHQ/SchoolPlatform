# ==========================================================
#  SchoolPlatform - نموذج متغيرات البيئة للإنتاج
#  انسخ هذا الملف إلى:  /etc/schoolplatform/.env
#  وعدّل القيم حسب السيرفر والنطاق ثم شغّل deploy.sh
# ==========================================================

# --- إعدادات Django الأساسية ------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production

# اسم النطاق (يستخدمه deploy.sh في إعداد nginx)
DOMAIN=example.com

# المفتاح السري (إجباري - اجعله طويلاً وعشوائياً)
DJANGO_SECRET_KEY=غيّر-هذه-القيمة-إلى-مفتاح-عشوائي-طويل-صعب

# النطاقات المسموحة مفصولة بفواصل (دون https://)
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# رابط لوحة إدارة Django (يُفضّل قيمة سرية - انتبه: بدون slash في النهاية)
DJANGO_ADMIN_URL=school-admin-9x4/

# أصول موثوقة لـ CSRF (بما فيها https:// - إجباري في الإنتاج)
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- سياسات الأمان (تُفعّل افتراضياً True) -----------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- قاعدة البيانات ---------------------------------------
# SQLite افتراضياً. للتبديل إلى PostgreSQL املأ هذه المتغيرات:
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
